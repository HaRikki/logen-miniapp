# ---- Server ----
NODE_ENV=development
PORT=3000
# Public origin of the app (used for cookies, sharing links, Telegram webhook docs)
APP_BASE_URL=http://localhost:3000
# Extra browser origins allowed for credentialed CORS (comma separated). Leave empty when
# the frontend is served by the backend (same origin — the recommended/default setup).
ALLOWED_ORIGINS=
# Secret used to sign session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Domain running real migrations. sqlite (dev/test) or postgres (production)
DB_CLIENT=sqlite
SQLITE_FILE=./data/digital-store.sqlite3
# PostgreSQL connection string (required when DB_CLIENT=postgres)
DATABASE_URL=postgresql://store:store@localhost:5432/digital_store

# ---- Telegram ----
# Bot token from @BotFather. NEVER exposed to the frontend.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to access /admin (bootstrap admins).
ADMIN_TELEGRAM_USER_IDS=
# Reject initData older than this many seconds (Telegram recommends 86400)
TELEGRAM_MAX_AUTH_AGE_SEC=86400
# Allow passwordless "demo login" on plain website. MUST be false in production.
ALLOW_DEMO_LOGIN_IN_DEV=true

# ---- Store ----
STORE_NAME=Digital Store
DEFAULT_CURRENCY=USD
TIMEZONE=Asia/Phnom_Penh

# ---- Uploads ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---- Payments / deposits ----
# Hours before an unpaid deposit request expires
DEPOSIT_EXPIRY_HOURS=24
# Optional gateway secret for verifying inbound webhook signatures (HMAC-SHA256 of raw body)
PAYMENT_WEBHOOK_SECRET=

# ---- Rate limits (per window) ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
